  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "messaging",
        "structural",
        "cloud",
        "data",
        "ai_cognitive",
        "specialized",
        "api_gateway",
        "coordination",
        "dataflow",
        "presentation"
      ],
      "description": "Pattern category"
    },
    "name": {
      "type": "string",
      "description": "Pattern name (kebab-case)"
    },
    "context": {
      "type": "string",
      "description": "Problem context describing when this pattern is applicable"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of benefits this pattern provides"
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tradeoffs and disadvantages"
    },
    "quality_attributes": {
      "type": "object",
      "properties": {
        "scalability": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "maintainability": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "reliability": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "security": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "performance": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "simplicity": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 10
      }
    },
    "suitable_domains": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/architectureDomain"
      },
      "description": "Domains where this pattern works well"
    },
    "unsuitable_domains": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/architectureDomain"
      },
      "description": "Domains where this pattern should be avoided"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific use case examples"
    },
    "avoid_when": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Situations when this pattern should be avoided"
    },
    "component_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key component types involved in this pattern"
    },
    "technology_stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Technologies commonly used with this pattern"
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common anti-patterns to avoid"
    },
    "migration_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patterns commonly migrated from"
    },
    "migration_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patterns commonly migrated to"
    },
    "related_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conceptually related patterns in the catalog (canonical names, resolvable via get_architecture_pattern)"
    },
    "design_principles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Core design principles for this pattern"
    },
    "best_practices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended best practices"
    }
  }
