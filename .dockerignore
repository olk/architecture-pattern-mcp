# Build context is project root. Exclude everything not needed for the image.

# VCS and source control
.git

# IDE, editor, and tooling metadata
.github
.opencode
.sdd
.worktrees

# Python packaging and virtualenv (uv sync rebuilds inside container)
.venv
*.egg-info

# Type checking, linting, and test caches
.mypy_cache
.pytest_cache
.ruff_cache

# Documentation (only docs/pattern/ is copied explicitly in the Dockerfile)
docs
# Re-include docs/pattern/ which is needed in the image
!docs/pattern/

# Local configuration (mounted as volume at runtime, not baked into image)
config
# Re-include config.json for the baked-config image build
!config/config.json

# Helm charts (not needed for Docker image)
charts

# Docker itself (the docker/ directory and Dockerfile are used by docker build, not needed in context)
docker

# Root-level project files not needed inside the image
Makefile
README.md
*.md
